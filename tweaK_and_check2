PARAM_NAMES = ["n_estimators", "max_depth", "learning_rate",
               "subsample", "colsample_bytree", "min_child_weight", "reg_lambda"]
PARAM_IDX   = {name: i for i, name in enumerate(PARAM_NAMES)}


def train_model(train_df, val_df, param_set):
    n_estimators, max_depth, lr, subsample, colsample_bytree, min_child_weight, reg_lambda = param_set
    model = xgb.XGBRegressor(
        n_estimators=n_estimators, max_depth=max_depth, learning_rate=lr,
        subsample=subsample, colsample_bytree=colsample_bytree,
        min_child_weight=min_child_weight, reg_lambda=reg_lambda,
        tree_method="hist", n_jobs=-1, early_stopping_rounds=30,
    )
    model.fit(
        train_df[FEATURE_COLUMNS], train_df[TARGET_COLUMN],
        eval_set=[(val_df[FEATURE_COLUMNS], val_df[TARGET_COLUMN])],
        verbose=False,
    )

    """
    importance = pd.Series(
        model.feature_importances_,
        index=FEATURE_COLUMNS
    ).sort_values(ascending=False)
    print(importance)
    """
    return model
    


